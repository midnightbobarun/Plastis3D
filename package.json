{
  "name": "plastis3d",
  "version": "0.1.0",
  "private": true,
  "description": "Plastis3D — a free, local 3D scene viewer and editor inside Hermes Desktop. Build tooling only; the plugin itself ships no Node runtime.",
  "license": "MIT",
  "scripts": {
    "build:desktop": "node scripts/build-desktop.mjs",
    "lint:desktop": "node scripts/lint-desktop.mjs",
    "test:python": "pytest tests/python",
    "test:node": "vitest run tests/node",
    "typecheck": "tsc --noEmit",
    "test:harness": "node scripts/build-desktop.mjs && npx playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "opentype.js": "2.0.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.16"
  }
}
